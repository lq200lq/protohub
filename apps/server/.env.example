# 复制成 .env.development / .env.production 后按需填值。
# 四个密钥必须各自 `openssl rand -base64 48` 生成，且两两不同：
# 直接沿用下面的占位值会被启动校验拒绝（长度与"彼此不同"两道检查）。
NODE_ENV=development

HOST=127.0.0.1
PORT=3100

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/protohub

# 用于拼原型访问地址与门面页的登录跳转。
PUBLIC_BASE_URL=http://127.0.0.1:3100

# 存储根目录，支持 ~ 写法；下面固定四个子目录：tmp / releases / manifests / trash。
STORAGE_ROOT=~/protohub-storage

# 生产填 nginx（静态产物由 nginx 直出），开发填 node。
SERVE_STATIC=node

JWT_ACCESS_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48_access
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48_refresh
SESSION_COOKIE_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48_session
ACCESS_TOKEN_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48_token

# 可选：不填则用 docs/部署与运维方案.md §2 的默认值。
# ACCESS_TOKEN_TTL=2h
# REFRESH_TOKEN_TTL=7d
# UNLOCK_TOKEN_TTL=24h
# MAX_UPLOAD_BYTES=104857600
# MAX_ENTRIES=5000
# MAX_FILE_BYTES=209715200
# MAX_TOTAL_BYTES=524288000
# MAX_RATIO=1000
# MAX_CONCURRENT_TASKS=1
# KEEP_RECENT_RELEASES=5
# KEEP_MIN_DAYS=30
# TRASH_TTL_DAYS=7
# ACCESS_LOG_KEEP_DAYS=180
# TASK_KEEP_DAYS=90
# ACCESS_CHECK_ALLOW_CIDRS=127.0.0.1/32
# LOG_LEVEL=info
