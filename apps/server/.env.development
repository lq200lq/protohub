# 开发环境配置（apps/server 读取，文件名与 docs/迭代实施计划.md §3.3 一致）。
# 这四个密钥只是本地假值，互不相同才能过启动校验；生产环境由环境变量注入，绝不复用这里的值。
NODE_ENV=development

# 只监听回环地址：localhost 会同时解析到 ::1，同端口上别的进程可能截走请求。
HOST=127.0.0.1
PORT=3100

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/protohub

# 开发期原型访问链接指向 Node 本身（管理台在 5666，同域不同端口）。
PUBLIC_BASE_URL=http://127.0.0.1:3100

STORAGE_ROOT=~/protohub-storage
# 无 nginx，静态产物由 Node 直出。
SERVE_STATIC=node

JWT_ACCESS_SECRET=dev-only-jwt-access-secret-3f9c1a7bd2e84c05
JWT_REFRESH_SECRET=dev-only-jwt-refresh-secret-6a2e0c4fd17b93e8
SESSION_COOKIE_SECRET=dev-only-session-cookie-secret-9d4b7e2a1c8f0536
ACCESS_TOKEN_SECRET=dev-only-access-token-secret-2c8f5a1e9b7d4306

# 其余阈值走代码内默认值（见 docs/部署与运维方案.md §2）；需要调时取消注释。
# LOG_LEVEL=debug
# MAX_UPLOAD_BYTES=104857600
