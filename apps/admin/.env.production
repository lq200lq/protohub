VITE_BASE=/

# 接口地址（与 nginx 同域，nginx 反代到 Node；见 docs/前端设计.md §1.2）
VITE_GLOB_API_URL=/api

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=brotli

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式（nginx 需配 fallback）
VITE_ROUTER_HISTORY=history

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=false
