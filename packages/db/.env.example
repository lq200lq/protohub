# @protohub/db 环境变量示例（复制为本地 .env 使用；不要提交真实密码到仓库）
# 项目约定：连接串一律用 127.0.0.1，禁止主机名 localhost（可能解析到别的 PG 实例）。

# 开发库（本机 Homebrew PostgreSQL 17，库已存在且为空）
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/protohub?schema=public

# 测试库（由 pnpm db:migrate 自动检测并创建，与开发库同实例）
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/protohub_test?schema=public

# prisma migrate dev 的 shadow database（superuser 会自动建/删；通常无需单独设置）
# SHADOW_DATABASE_URL=
